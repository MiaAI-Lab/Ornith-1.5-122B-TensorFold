+    /// `run` over a plan the caller already built (tile 64) for `mixedEligible` layers: xg and xu are fp16 [pairs, dims]
+    /// scratch, xd fp16 [pairs, width], y fp32 [pairs, dims]; items bounds the plan's items.
+    pub fn runMixed(k: Kernels, e: *const ex.Experts, s: Stream, l: ex.Layer, x: u64, stride: usize, picks: u64, rows: usize, slots: usize, xg: u64, xu: u64, xd: u64, y: u64, p: grouped.Plan, items: usize) !void {
+        if (!mixedEligible(l) or rows == 0 or stride < l.dims or stride > std.math.maxInt(i32)) return error.Exl3Shape;
+        const pairs = rows * slots;
+        var args: launch.Args = .{};
+        inline for (.{ x, i(stride), @as(i32, @backingInt(ex.DType.bf16)), picks, l.suh_g, l.suh_u, xg, xu, i(l.dims), i(slots), i(l.experts) }) |v| args.add(v);
+        try launch.launch(e.rot_in, .{ .grid = .{ .x = @intCast(pairs), .y = @intCast(l.dims / 128), .z = 2 }, .block = .{ .x = 32 } }, s, &args);
+        const tail = i(l.experts - 1);
+        const fs = [2]Function{ k.gu_m8, k.gu_m10 };
+        const ds = [2]Function{ k.down_m8, k.down_m10 };
