+/// mul1 experts with one width for the routed experts and another for the last (the shared expert, Qwen3.5-MoE): the
+/// 4- and 5-bit instantiations launch over the same plan, each skipping the other's experts.
+pub fn mixedEligible(l: ex.Layer) bool {
+    return l.codebook == .mul1 and l.routed_k2 == 8 and l.tail_k2 == 10 and l.gu_stride == 0 and !l.shared_input and l.experts > 1 and l.dims > 0 and l.width > 0 and l.dims % 256 == 0 and l.width % 128 == 0 and (l.act_mode == 0 or l.act_mode == 1);
+}
 fn mul(a: usize, b: usize) !usize {
     return std.math.mul(usize, a, b) catch error.Exl3Shape;
