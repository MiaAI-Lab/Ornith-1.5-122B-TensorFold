+                const uint32_t b1 = bfbits(*reinterpret_cast<const unsigned short*>(kr + ks * 8 * GKP + GKP + nn * 8));
+                mma_tf32(S[nn], __float_as_uint(acc[ks][0]), __float_as_uint(acc[ks][2]), __float_as_uint(acc[ks][1]), __float_as_uint(acc[ks][3]), b0, b1);
+            }
+        }
+    }
+    {
+        float* st = reinterpret_cast<float*>(sg.rec) + (size_t)layer * geo.rec() + ((size_t)hv * DK + d0) * DK;
+#pragma unroll
+        for (int n = 0; n < 16; n++) {
+            *reinterpret_cast<float2*>(st + (size_t)gq * DK + 8 * n + 2 * tq) = make_float2(S[n][0], S[n][1]);
