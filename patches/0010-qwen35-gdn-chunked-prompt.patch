+
+// TF_GDN_DIFF: mode 0 saves the stream's layer recurrence to buf, 1 restores it, 2 compares it with buf (and y0 with y1,
+// rows x nv x DK) into stats: [max |dy|, sum dy^2, sum y0^2, max |dS|, sum dS^2, sum S^2]. Grid-stride, 1-D.
+extern "C" __global__ void __launch_bounds__(256) tf_q35_gdn_cdiff(Geo geo, const Seg* __restrict__ segs, int layer, int mode, float* __restrict__ buf,
+                                                                     const __nv_bfloat16* __restrict__ y0, const __nv_bfloat16* __restrict__ y1, int rows,
+                                                                     float* __restrict__ stats) {
+    float* S = reinterpret_cast<float*>(segs[0].rec) + (size_t)layer * geo.rec();
+    const size_t n = geo.rec(), stride = (size_t)gridDim.x * blockDim.x;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < n; i += stride) {
+        if (mode == 0) buf[i] = S[i];
+        else if (mode == 1) S[i] = buf[i];
+        else {
+            const float d = fabsf(S[i] - buf[i]);
+            atomicMax(reinterpret_cast<int*>(stats + 3), __float_as_int(d));
+            atomicAdd(stats + 4, d * d);
+            atomicAdd(stats + 5, buf[i] * buf[i]);
+        }
+    }
+    if (mode != 2) return;
+    const size_t m = (size_t)rows * geo.nv * DK;
+    for (size_t i = (size_t)blockIdx.x * blockDim.x + threadIdx.x; i < m; i += stride) {
+        const float a = bf(y0[i]), d = fabsf(a - bf(y1[i]));
+        atomicMax(reinterpret_cast<int*>(stats), __float_as_int(d));
+        atomicAdd(stats + 1, d * d);
+        atomicAdd(stats + 2, a * a);
+    }
+}
