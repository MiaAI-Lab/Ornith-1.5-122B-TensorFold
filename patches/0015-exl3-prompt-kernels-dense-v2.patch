diff --git a/zig/kernels/cuda/exl3_candidate.cu b/zig/kernels/cuda/exl3_candidate.cu
index a288cb5..b6af079 100644
--- a/zig/kernels/cuda/exl3_candidate.cu
+++ b/zig/kernels/cuda/exl3_candidate.cu
@@ -176,6 +176,77 @@ TF_EXL3_PROMPT(0)
 TF_EXL3_PROMPT(1)
 TF_EXL3_PROMPT(2)
 
+// Prompt v2: TF_DENSE_TP rows x 128 columns a block of four warps (two 16-column weight tiles each), the expert kernels' ring
+// of cp.async stages with ldmatrix'd rows (exl3_prompt.cuh), so a weight tile decodes once for TF_DENSE_TP rows. The sums are
+// accumulated in the same k order as the kernels above and finished the same way.
+#include "exl3_decode.cuh"
+#include "exl3_prompt.cuh"
+#ifndef TF_DENSE_TP
+#define TF_DENSE_TP 128
+#endif
+#ifndef TF_DENSE_NW
+#define TF_DENSE_NW 8   // warps a block: 8 / NW weight tiles each
+#endif
+#ifndef TF_DENSE_BLOCKS
+#define TF_DENSE_BLOCKS 2
+#endif
+constexpr int TF_DP_SMEM = 3 * tf_exl3_prompt::tstage_halves<TF_DENSE_TP, 16, 8>() * 2;
+static_assert(TF_DP_SMEM <= 48 * 1024, "the dense prompt stages must fit static shared memory");
+static_assert(TF_DP_SMEM >= (TF_DENSE_TP / 2) * (128 + 4) * 4, "the epilogue sums reuse the stages");
+
+template <int K2, int C>
+__device__ __forceinline__ void tf_exl3_prompt2_job(const __half* Xh, unsigned rows, const uint8_t* T, const __half* svh,
+                                                    const TfExl3Matrix m, uint8_t* Y, unsigned y_f32, unsigned char* smem) {
+  using namespace tf_exl3_prompt;
+  constexpr int TP = TF_DENSE_TP, NW = TF_DENSE_NW, NBT = 8, TMTL = NBT / NW, TH = TP / 2, ES = 128 + 4;
+  __shared__ int rows_sh[TP];
+  const int ob = blockIdx.x, warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+  const unsigned row0 = blockIdx.y * TP;
+  const int cnt = min((int)(rows - row0), TP);
+  for (int i = threadIdx.x; i < TP; i += NW * 32) rows_sh[i] = i < cnt ? (int)row0 + i : -1;
+  __syncthreads();
+  float acc[TMTL][TP / 8][4];
+  const uint32_t* Tw = reinterpret_cast<const uint32_t*>(T);
+  tmain<1, TP, K2, C, NW, NBT, TP>(Xh, Xh, Tw, Tw, rows_sh, cnt, (int)m.k, (int)m.tiles_n, ob, 1, reinterpret_cast<half*>(smem), acc);
+  float* E = reinterpret_cast<float*>(smem);
+  for (int hf = 0; hf < 2 && hf * TH < cnt; ++hf) {
+    if (hf) __syncthreads();   // the first half's rows are read
+    tspill(E, ES, warp * TMTL * 16, acc, hf);
+    __syncthreads();
+    for (int i = warp; i < TH && hf * TH + i < cnt; i += NW) {
+      float v[4];
+      for (int q = 0; q < 4; ++q) v[q] = E[i * ES + lane + 32 * q];
+      tf_exl3_fwht(v, lane);
+      for (int q = 0; q < 4; ++q) {
+        const unsigned c = ob * 128 + lane + 32 * q;
+        tf_exl3_store(Y, (uint64_t)(row0 + hf * TH + i) * m.n + c, __fmul_rn(v[q], __fmul_rn(__half2float(svh[c]), 0.125f)), y_f32);
+      }
+    }
+  }
+}
+
+#define TF_EXL3_PROMPT2(C)                                                                                           \
+  extern "C" __global__ void __launch_bounds__(TF_DENSE_NW * 32, TF_DENSE_BLOCKS) tf_exl3_prompt2_##C(const __half* Xh, unsigned rows,          \
+                                                                          const uint8_t* T, const __half* svh,      \
+                                                                          const TfExl3Matrix m, uint8_t* Y,          \
+                                                                          unsigned y_f32) {                          \
+    __shared__ __align__(16) unsigned char smem[TF_DP_SMEM];                                                         \
+    switch (m.bits) {                                                                                                \
+      case 1: tf_exl3_prompt2_job<2, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                 \
+      case 2: tf_exl3_prompt2_job<4, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                 \
+      case 3: tf_exl3_prompt2_job<6, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                 \
+      case 4: tf_exl3_prompt2_job<8, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                 \
+      case 5: tf_exl3_prompt2_job<10, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                \
+      case 6: tf_exl3_prompt2_job<12, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                \
+      case 7: tf_exl3_prompt2_job<14, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                \
+      case 8: tf_exl3_prompt2_job<16, C>(Xh, rows, T, svh, m, Y, y_f32, smem); break;                                \
+      default: break;                                                                                                \
+    }                                                                                                                \
+  }
+TF_EXL3_PROMPT2(0)
+TF_EXL3_PROMPT2(1)
+TF_EXL3_PROMPT2(2)
+
 
