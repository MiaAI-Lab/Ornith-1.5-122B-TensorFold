                 if (reuse.restoreCache(self.e, cache, saved, seen)) {
                     at = stream.reuse.at;
                     stream.cached = stream.reuse.at;
@@ -332,8 +367,17 @@ const Lanes = struct {
         }
         cache.untaught = stream.untaught;
         while (at < ids.len) {
-            const end = nextCut(ids.len, stream.chunks, at);
+            const end = nextCut(ids.len, stream.chunks, at, images != null);
+            // a mark the store asked for on a grid line inside this pass: the pass keeps the state there as it goes
+            var mid = midMark(stream.reuse.marks, at, end);
+            if (mid != 0 and (images != null or !self.e.midReady(end - at, mid - at))) mid = 0; // (image prompts keep to real cuts)
+            self.e.mid_rows = if (mid != 0) mid - at else 0;
             try self.e.forward(&.{.{ .cache = cache, .rows = end - at, .images = if (images) |*im| im else null }}, ids[at..end], .last);
+            if (mid != 0) if (stream.reuse.hook) |k| {
+                cache.mid_at = mid;
+                defer cache.mid_at = 0;
+                k.at(k.ptr, stream, @intCast(mid));
+            };
             at = end;
             // a mark the store asked for, where this pass cut anyway: the lane host copies the state here
             if (end < ids.len and std.mem.indexOfScalar(u32, stream.reuse.marks, @intCast(end)) != null) {
diff --git a/zig/src/families/qwen3_5/cuda_reuse.zig b/zig/src/families/qwen3_5/cuda_reuse.zig
