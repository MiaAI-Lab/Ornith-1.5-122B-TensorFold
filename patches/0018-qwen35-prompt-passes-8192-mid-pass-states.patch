@@ -623,7 +629,8 @@ pub const Engine = struct {
         const segs = e.tables.ptr + segs_at;
         const blocks = (total + gdn_block - 1) / gdn_block;
         try e.run(e.fns.gdn_cmat, .{ blocks, e.g.k_heads, 1 }, .{ 128, 1, 1 }, .{ e.geo, e.q, e.k, e.g_, e.beta, segs, e.gdn_scr, e.gdn_aux });
-        try e.runShared(e.fns.gdn_cscan, .{ e.g.v_heads, geometry.dk / (16 * gdn_warps), 1 }, .{ 32 * gdn_warps, 1, 1 }, gdn_scan_smem, .{ e.geo, e.q, e.k, e.v, segs, layer, y, e.gdn_scr, e.gdn_aux });
+        const snap_blk: c_int = if (e.mid_rows > 0) @intCast(e.mid_rows / gdn_block) else -1;
+        try e.runShared(e.fns.gdn_cscan, .{ e.g.v_heads, geometry.dk / (16 * gdn_warps), 1 }, .{ 32 * gdn_warps, 1, 1 }, gdn_scan_smem, .{ e.geo, e.q, e.k, e.v, segs, layer, y, e.gdn_scr, e.gdn_aux, snap_blk });
     }
 
     /// TF_GDN_DIFF: both scans from the same recurrence, the difference printed; the sequential results stay.
@@ -654,6 +661,7 @@ pub const Engine = struct {
     pub const body = @import("cuda_forward.zig").body;
 
     pub const routedRows = routed.rows;
+    pub const midReady = @import("cuda_forward.zig").midReady;
 
