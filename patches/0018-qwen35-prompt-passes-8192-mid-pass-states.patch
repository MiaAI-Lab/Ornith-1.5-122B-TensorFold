diff --git a/zig/kernels/cuda/qwen35_gdn_chunk.cuh b/zig/kernels/cuda/qwen35_gdn_chunk.cuh
index 248c1b3..e76ff49 100644
--- a/zig/kernels/cuda/qwen35_gdn_chunk.cuh
+++ b/zig/kernels/cuda/qwen35_gdn_chunk.cuh
@@ -140,7 +140,8 @@ constexpr int GKP = DK + 8;    // tile row stride (bf16)
 constexpr int GSCAN_SMEM = 2 * GC * GKP * 2 + GTB * 4 + 8 * 64 * 4 + 4 * GC * 4;
 extern "C" __global__ void __launch_bounds__(GNW * 32) tf_q35_gdn_cscan(Geo geo, const __nv_bfloat16* __restrict__ q, const __nv_bfloat16* __restrict__ k,
                                                                              const __nv_bfloat16* __restrict__ v, const Seg* __restrict__ segs, int layer,
-                                                                             __nv_bfloat16* __restrict__ y, const float* __restrict__ raw, const float* __restrict__ aux) {
+                                                                             __nv_bfloat16* __restrict__ y, const float* __restrict__ raw, const float* __restrict__ aux,
+                                                                             int snap_blk) {
     const int NK = geo.nk, NV = geo.nv;
     const int hv = blockIdx.x, hk = hv / (NV / NK);
     const int tid = threadIdx.x, warp = tid >> 5, lane = tid & 31, gq = lane >> 2, tq = lane & 3;
@@ -184,6 +185,15 @@ extern "C" __global__ void __launch_bounds__(GNW * 32) tf_q35_gdn_cscan(Geo geo,
         }
     }
     for (int blk = 0; blk < nblk; blk++) {
+        if (blk == snap_blk) {
+            // the recurrence after the first blk * GC rows, into Seg.before (the prompt cache's state at that row: cuda_reuse.zig)
+            float* st = reinterpret_cast<float*>(sg.before) + (size_t)layer * geo.rec() + ((size_t)hv * DK + d0) * DK;
+#pragma unroll
+            for (int n = 0; n < 16; n++) {
+                *reinterpret_cast<float2*>(st + (size_t)gq * DK + 8 * n + 2 * tq) = make_float2(S[n][0], S[n][1]);
+                *reinterpret_cast<float2*>(st + (size_t)(gq + 8) * DK + 8 * n + 2 * tq) = make_float2(S[n][2], S[n][3]);
+            }
+        }
         const int rel = blk * GC;
         const int n = min(GC, sg.rows - rel), r0 = sg.row0 + rel;
         const float* rq = raw + ((size_t)blk * NK + hk) * GRAW;  // Q K^T blocks, then K K^T blocks
@@ -366,6 +376,19 @@ extern "C" __global__ void __launch_bounds__(GNW * 32) tf_q35_gdn_cscan(Geo geo,
     }
 }
 
+// The conv tail after the first `mid` rows of the pass (its last TAPS - 1 input rows), into Seg.before beside tf_q35_gdn_cscan's
+// recurrence: what tf_q35_conv_commit leaves in Seg.conv after a pass of `mid` rows. Grid (ceil(C / 256)), one stream.
+extern "C" __global__ void __launch_bounds__(256) tf_q35_conv_snap(Geo geo, const __nv_bfloat16* __restrict__ QKV, const Seg* __restrict__ segs,
+                                                                     int layer, int mid) {
+    const int C = geo.conv();
+    const int c = blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= C) return;
+    const Seg sg = segs[0];
+    __nv_bfloat16* out = reinterpret_cast<__nv_bfloat16*>(sg.before + geo.nl * geo.rec() * sizeof(float)) + (size_t)layer * geo.conv_rows();
+    for (int r = 0; r < TAPS - 1; r++) out[(size_t)r * C + c] = QKV[(size_t)(sg.row0 + mid - (TAPS - 1) + r) * C + c];
+}
+
+
 // TF_GDN_DIFF: mode 0 saves the stream's layer recurrence to buf, 1 restores it, 2 compares it with buf (and y0 with y1,
 // rows x nv x DK) into stats: [max |dy|, sum dy^2, sum y0^2, max |dS|, sum dS^2, sum S^2]. Grid-stride, 1-D.
 extern "C" __global__ void __launch_bounds__(256) tf_q35_gdn_cdiff(Geo geo, const Seg* __restrict__ segs, int layer, int mode, float* __restrict__ buf,
