     pub fn rowLogits(e: *const Engine, i: usize) []const u16 {
diff --git a/zig/src/families/qwen3_5/cuda_forward.zig b/zig/src/families/qwen3_5/cuda_forward.zig
index 9369d86..534f039 100644
--- a/zig/src/families/qwen3_5/cuda_forward.zig
+++ b/zig/src/families/qwen3_5/cuda_forward.zig
@@ -31,6 +31,11 @@ fn chunkScan(e: *E.Engine, prompt: bool, record: bool, total: usize, nseg: usize
     return prompt and !record and nseg == 1 and total >= gdn_chunk_min and !e.gdn_seq and e.g.v_heads % e.g.k_heads == 0 and geometry.dk == 128;
 }
 
+/// Whether a prompt pass of `rows` rows can keep the state at row `mid` as it goes: the chunkwise scan runs, mid is one of its block boundaries.
+pub fn midReady(e: *E.Engine, rows: usize, mid: usize) bool {
+    return mid > 0 and mid < rows and mid % E.gdn_block == 0 and mid >= 3 and chunkScan(e, true, false, rows, 1) and !e.gdn_diff and e.learning == null and !e.pockets.any();
+}
+
 pub fn promptMoe(prompt: bool, rows: usize) bool {
     return prompt and rows > prompt_moe_cutoff;
 }
@@ -70,6 +75,7 @@ pub fn body(e: *E.Engine, shape: anytype) !void {
                 if (e.learning) |k| try k.delta(i, e.qkv, e.z, e.b, e.a, total);
                 try e.run(e.fns.gdn_pre, .{ 1, 2 * g.k_heads + g.v_heads, total }, .{ 32, 1, 1 }, .{ geo, e.qkv, t_segs, t_rows, t_par, layer, m.conv, e.a, e.b, m.a_log, m.dt_bias, e.q, e.k, e.v, e.g_, e.beta, t_params });
                 try e.run(e.fns.conv_commit, .{ (g.convWidth() + 255) / 256, nseg, 1 }, .{ 256, 1, 1 }, .{ geo, e.qkv, t_segs, t_par, layer, t_params });
+                if (e.mid_rows > 0) try e.run(e.fns.conv_snap, .{ (g.convWidth() + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.qkv, t_segs, layer, @as(c_int, @intCast(e.mid_rows)) });
                 if (chunkScan(e, prompt, record, total, nseg)) {
                     if (e.gdn_diff) try e.chunkScanDiff(total, layer) else try e.chunkScan(total, layer, e.y);
                 } else if (prompt and total > prompt_moe_cutoff and !e.old_gdn) try e.promptScan(nseg, layer) else try e.deltaScan(record, shape.slots, nseg, layer);
