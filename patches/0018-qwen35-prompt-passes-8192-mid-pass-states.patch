@@ -117,7 +117,10 @@ pub fn save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
 
 /// A host copy of `cache` at `at` rows, naming the prompt's images that start before it.
 pub fn saveCache(e: *Engine, cache: *const Cache, at: usize, seen: []const Seen) !*Copy {
-    if (cache.len != at or cache.last != null or at > cache.cap) return error.NotAtMark;
+    // a mid-pass mark: the pass ended further on, the state at `at` was kept in `before` (Engine.mid_rows), the rows before `at` are in kv
+    const mid = cache.mid_at != 0 and cache.mid_at == at and cache.len > at;
+    if (!mid and cache.len != at) return error.NotAtMark;
+    if (cache.last != null or at > cache.cap) return error.NotAtMark;
     const l: Layout = .{ .g = e.g, .format = formatOf(e), .cap = cache.cap, .at = at };
     var n: usize = 0;
     for (seen) |im| n += @intFromBool(im.at < at);
@@ -135,7 +138,8 @@ pub fn saveCache(e: *Engine, cache: *const Cache, at: usize, seen: []const Seen)
     var off: usize = 0;
     for (0..l.count()) |i| {
         const p = l.piece(i);
-        const dev = (if (p.kv) cache.kv.ptr else cache.state.ptr) + p.off;
+        const state_at = if (mid) (cache.before orelse return error.MissingQwenBefore).ptr else cache.state.ptr;
+        const dev = (if (p.kv) cache.kv.ptr else state_at) + p.off;
         if (p.len > 0) try e.d.check(e.d.api.cuMemcpyDtoHAsync_v2(copy.host.bytes.ptr + off, dev, p.len, e.stream.handle), "cuMemcpyDtoHAsync");
         off += p.len;
     }
diff --git a/zig/src/families/qwen3_5/cuda_round.zig b/zig/src/families/qwen3_5/cuda_round.zig
