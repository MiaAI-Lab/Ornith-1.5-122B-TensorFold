+/// Rows a prompt pass is cut at when no request chunk start comes first (a pass may be longer: one grid line inside it is kept as it goes).
+pub const snap_grid: u32 = 4096;
 
 /// explain() words open refusals too (--vision on a checkpoint without a tower it reads).
 pub const explains_open = true;
