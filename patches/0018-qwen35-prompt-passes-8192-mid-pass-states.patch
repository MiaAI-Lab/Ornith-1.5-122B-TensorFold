-/// Where a prompt pass from `at` cuts its chunk: max_rows rows on, or the request's next chunk start before that.
-fn nextCut(len: usize, chunks: []const u32, at: usize) usize {
-    var end: usize = @min(len, at + E.max_rows);
+/// Where a prompt pass from `at` cuts its chunk: max_rows rows on, at most one snapshot grid line inside it (the pass keeps the
+/// state there as it goes: Engine.mid_rows), or the request's next chunk start before that.
+fn nextCut(len: usize, chunks: []const u32, at: usize, real: bool) usize {
+    // `real`: every grid line is a cut (image prompts)
+    var end: usize = @min(len, @min(at + E.max_rows, (at / snap_grid + @as(usize, if (real) 1 else 2)) * snap_grid));
     for (chunks) |boundary| if (boundary > at) {
         end = @min(end, boundary);
         break;
@@ -191,22 +194,54 @@ fn nextCut(len: usize, chunks: []const u32, at: usize) usize {
     return end;
 }
 
-/// Whether a cold pass over `len` rows (from 0) cuts a chunk at `pos`.
-fn coldCut(len: usize, chunks: []const u32, pos: usize) bool {
+/// Whether the grid line `pos`, inside the pass [at, end), is one of its scan's block boundaries (so a pass resumed there computes the rest
+/// as the pass through does).
+fn midLine(pos: usize, at: usize, end: usize) bool {
+    return pos > at and pos < end and pos % snap_grid == 0 and (pos - at) % E.gdn_block == 0;
+}
+
+/// Rows a pass resumed at a grid line needs to run as the rows inside the cold pass did: the prompt kernels (scan, attention, experts)
+/// take over from the decode ones past 16 rows, the chunkwise scan from 32 (cuda_forward.zig).
+const resume_min: usize = 32;
+
+/// Whether a cold pass over `len` rows (from 0) cuts a chunk at `pos`, or passes a grid line there that a pass keeps as it goes.
+fn coldCut(len: usize, chunks: []const u32, pos: usize, real: bool) bool {
     var at: usize = 0;
-    while (at < pos and at < len) at = nextCut(len, chunks, at);
+    while (at < len) {
+        if (pos == at) return true;
+        const end = nextCut(len, chunks, at, real);
+        if (pos < end) return midLine(pos, at, end) and len - pos >= resume_min;
+        at = end;
+    }
     return at == pos;
 }
 
-test "a pass resumes only where a cold pass cuts: every max_rows rows from 0 or from the request's chunk starts" {
-    const len = 8 * E.max_rows - 24;
-    try std.testing.expect(coldCut(len, &.{}, E.max_rows * 3));
-    try std.testing.expect(!coldCut(len, &.{}, E.max_rows * 3 + 1));
-    try std.testing.expect(coldCut(len, &.{200}, 200));
-    try std.testing.expect(coldCut(len, &.{200}, 200 + E.max_rows));
-    try std.testing.expect(!coldCut(len, &.{200}, 2 * E.max_rows)); // cut at 200 instead, then 200 + max_rows
-    try std.testing.expectEqual(@as(usize, 200), nextCut(len, &.{200}, 0));
-    try std.testing.expectEqual(@as(usize, 200 + E.max_rows), nextCut(len, &.{200}, 200));
+/// The first mark the store asked for inside the pass [at, end) that the pass keeps as it goes (0: none).
+fn midMark(marks: []const u32, at: usize, end: usize) usize {
+    for (marks) |m| if (midLine(m, at, end)) return m;
+    return 0;
+}
+
+test "a pass resumes only where a cold pass cuts or keeps a grid line: every max_rows rows or grid line from 0 or from the request's chunk starts" {
+    const long = 10 * E.max_rows;
+    try std.testing.expect(coldCut(long, &.{}, snap_grid * 3, false)); // a grid line, kept inside a pass or cut at
+    try std.testing.expect(!coldCut(long, &.{}, snap_grid * 3 + 1, false));
+    try std.testing.expect(!coldCut(snap_grid + 5, &.{}, snap_grid, false)); // 5 rows resumed there would take the decode kernels
+    try std.testing.expect(coldCut(snap_grid + resume_min, &.{}, snap_grid, false));
+    try std.testing.expect(coldCut(long, &.{200}, 200, false));
+    try std.testing.expect(!coldCut(long, &.{200}, snap_grid, false)); // the pass from 200 has blocks at 200 + 64 k: 4096 is not one
+    try std.testing.expect(coldCut(long, &.{256}, snap_grid, false)); // the pass from 256 has: 3840 = 60 blocks
+    try std.testing.expectEqual(@as(usize, 200), nextCut(long, &.{200}, 0, false));
+    // one grid line inside a pass at most
+    try std.testing.expectEqual(@as(usize, 2 * snap_grid), nextCut(long, &.{}, 0, false));
+    try std.testing.expectEqual(@as(usize, 2 * snap_grid), nextCut(long, &.{}, 100, false));
+    try std.testing.expectEqual(@as(usize, 3 * snap_grid), nextCut(long, &.{}, snap_grid, false));
+    try std.testing.expectEqual(@as(usize, 5000), nextCut(5000, &.{}, 0, false));
+    try std.testing.expectEqual(@as(usize, snap_grid), nextCut(long, &.{}, 0, true)); // image prompts cut at every grid line
+    try std.testing.expect(coldCut(long, &.{}, snap_grid, true));
+    try std.testing.expectEqual(@as(usize, snap_grid), midMark(&.{ 0, snap_grid }, 0, 5000));
+    try std.testing.expectEqual(@as(usize, 0), midMark(&.{snap_grid}, 0, snap_grid));
+    try std.testing.expectEqual(@as(usize, 0), midMark(&.{1000}, 0, 5000));
 }
 
