diff --git a/zig/kernels/cuda/exl3_experts.cu b/zig/kernels/cuda/exl3_experts.cu
index 1094cc8..eaa65eb 100644
--- a/zig/kernels/cuda/exl3_experts.cu
+++ b/zig/kernels/cuda/exl3_experts.cu
@@ -23,22 +23,60 @@ struct GroupedArgs {
     int k, n, p, sk, maxm, slots, nexp_max, mats, ns, standard, skip;
 };
 
-// One warp's k tiles [kt0, kt0 + nkt) of an expert matrix into acc: per-lane loads and the shared decode (same bits).
+// A warp's k step of an expert matrix is NT tiles side by side, 16 * K2 contiguous bytes each: cp.async hands them to a
+// private ring in shared memory, D steps deep, so the trellis streams in while earlier steps decode.
+constexpr int RING_D = 4;
+
+__device__ __forceinline__ void cp_async16(void* smem, const void* gmem) {
+    asm volatile("cp.async.cg.shared.global [%0], [%1], 16;\n" ::"r"((uint32_t)__cvta_generic_to_shared(smem)), "l"(gmem));
+}
+__device__ __forceinline__ void cp_commit() { asm volatile("cp.async.commit_group;\n" ::); }
+template <int N>
+__device__ __forceinline__ void cp_wait() { asm volatile("cp.async.wait_group %0;\n" ::"n"(N)); }
+
+// Step `step` (k tile kt0 + step) of the warp's NT tiles into ring slot step % RING_D; always commits one group.
+template <int K2, int NT>
+__device__ __forceinline__ void ring_issue(const uint32_t* T, size_t kstride, int kt0, int nkt, int nt0, int step,
+                                           uint32_t* ring, int lane) {
+    constexpr int TW = tile_words<K2>(), CH = NT * TW / 4;   // 16-byte chunks of the step
+    if (step < nkt) {
+        const uint32_t* src = T + (size_t)(kt0 + step) * kstride + (size_t)nt0 * TW;
+        uint32_t* dst = ring + (step % RING_D) * (NT * TW);
+#pragma unroll
+        for (int c = lane; c < CH; c += 32) cp_async16(dst + 4 * c, src + 4 * c);
+    }
+    cp_commit();
+}
+
+// One warp's k tiles [kt0, kt0 + nkt) of an expert matrix into acc: ring loads and the shared decode (same bits).
+// The first RING_D steps must already be issued (ring_issue, steps 0 .. RING_D - 1).
 template <int CB, int K2, int NT>
 __device__ __forceinline__ void warp_tiles(const uint32_t* T, int ntiles, int kt0, int nkt, int nt0, const half* x0,
-                                           const half* x1, bool ok0, bool ok1, int lane, float (&acc)[NT][2][4]) {
+                                           const half* x1, bool ok0, bool ok1, int lane, uint32_t* ring,
+                                           float (&acc)[NT][2][4]) {
     constexpr int TW = tile_words<K2>(), LW = lane_words<K2>();
     const size_t kstride = (size_t)ntiles * TW;
-    for (int i = 0; i < nkt; ++i) {
-        const uint32_t* t0 = T + (size_t)(kt0 + i) * kstride + (size_t)nt0 * TW;
-        uint32_t w[NT][LW];
+    int word, offset;
+    lane_start<K2>(lane, word, offset);
+    int woff[LW];
 #pragma unroll
-        for (int j = 0; j < NT; ++j) ldg_lane_words<K2>(t0 + j * TW, lane, w[j]);
+    for (int q = 0; q < LW; ++q) woff[q] = (word + q) % TW;
+    for (int i = 0; i < nkt; ++i) {
         const int k = (kt0 + i) * 16;
         const uint32_t a[4] = {ok0 ? *reinterpret_cast<const uint32_t*>(x0 + k) : 0u,
                                ok1 ? *reinterpret_cast<const uint32_t*>(x1 + k) : 0u,
                                ok0 ? *reinterpret_cast<const uint32_t*>(x0 + k + 8) : 0u,
                                ok1 ? *reinterpret_cast<const uint32_t*>(x1 + k + 8) : 0u};
+        cp_wait<RING_D - 1>();
+        __syncwarp();
+        const uint32_t* st = ring + (i % RING_D) * (NT * TW);
+        uint32_t w[NT][LW];
+#pragma unroll
+        for (int j = 0; j < NT; ++j)
+#pragma unroll
+            for (int q = 0; q < LW; ++q) w[j][q] = st[j * TW + woff[q]];
+        __syncwarp();                                        // every lane has read the slot
+        ring_issue<K2, NT>(T, kstride, kt0, nkt, nt0, i + RING_D, ring, lane);
 #pragma unroll
         for (int j = 0; j < NT; ++j) {
             uint32_t b0[2], b1[2];
@@ -65,8 +103,28 @@ __device__ __forceinline__ void grouped_body(const GroupedArgs a, int u, int nbl
     const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
     const int g = lane >> 2, t = lane & 3;
     const int NTILES = a.ns > 0 ? a.ns : (a.n >> 4); // row stride of the trellis, in tiles
+    const int per_warp = (a.k >> 4) / a.sk / W;
+    const int kt0 = split * (per_warp * W) + warp * per_warp;
+    const int nt0 = nblock * NT;
 
     __shared__ int rows_sh[16];
+    __shared__ __align__(16) float red[W][16][NT * 16];   // the sums after the loop; the warp's trellis ring before
+    uint32_t* ring = reinterpret_cast<uint32_t*>(&red[warp][0][0]);
+    static_assert(RING_D * 128 * 16 <= 16 * NT * 16 * 4, "the ring of the widest width fits a warp's red slice");
+    if (a.standard && mtile * 16 >= a.uids[3 * u + 2]) return;   // an empty member tile
+    // the first steps of the trellis are on their way before the member rows arrive
+    switch (k2) {
+#define TF_EXL3X_PRE(K2_)                                                                                    \
+    case K2_:                                                                                                \
+        _Pragma("unroll") for (int s_ = 0; s_ < RING_D; ++s_) ring_issue<K2_, NT>(T, (size_t)NTILES * tile_words<K2_>(), kt0, per_warp, nt0, s_, ring, lane); \
+        break;
+        TF_EXL3X_PRE(2) TF_EXL3X_PRE(3) TF_EXL3X_PRE(4) TF_EXL3X_PRE(5) TF_EXL3X_PRE(6) TF_EXL3X_PRE(7) TF_EXL3X_PRE(8)
+        TF_EXL3X_PRE(9) TF_EXL3X_PRE(10) TF_EXL3X_PRE(11) TF_EXL3X_PRE(12) TF_EXL3X_PRE(13) TF_EXL3X_PRE(14)
+        TF_EXL3X_PRE(15) TF_EXL3X_PRE(16)
+#undef TF_EXL3X_PRE
+        default:
+            __trap();
+    }
     if (threadIdx.x < 16) {
         const int m = mtile * 16 + threadIdx.x;
         const int count = a.standard ? a.uids[3 * u + 2] : a.maxm;
@@ -75,14 +133,13 @@ __device__ __forceinline__ void grouped_body(const GroupedArgs a, int u, int nbl
         rows_sh[threadIdx.x] = a.standard ? code : (code >= 0 ? (code >> 5) * a.slots + (code & 31) : -1);
     }
     __syncthreads();
-    if (rows_sh[0] < 0) return; // members come first, so this tile is empty
+    if (rows_sh[0] < 0) {       // members come first, so this tile is empty
+        cp_wait<0>();
+        return;
+    }
     const int r0 = rows_sh[g], r1 = rows_sh[g + 8];
     const half* x0 = X + (size_t)(r0 < 0 ? 0 : r0) * a.k + 2 * t;
     const half* x1 = X + (size_t)(r1 < 0 ? 0 : r1) * a.k + 2 * t;
-    const int per_warp = (a.k >> 4) / a.sk / W;
-    const int kt0 = split * (per_warp * W) + warp * per_warp;
-    const int nt0 = nblock * NT;
-
     float acc[NT][2][4];
 #pragma unroll
     for (int i = 0; i < NT; ++i)
@@ -91,11 +148,10 @@ __device__ __forceinline__ void grouped_body(const GroupedArgs a, int u, int nbl
 #pragma unroll
             for (int c = 0; c < 4; ++c) acc[i][h][c] = 0.f;
 
-    __shared__ __align__(16) float red[W][16][NT * 16];
     switch (k2) {
 #define TF_EXL3X_CASE(K2_)                                                                                   \
     case K2_:                                                                                                \
-        warp_tiles<CB, K2_, NT>(T, NTILES, kt0, per_warp, nt0, x0, x1, r0 >= 0, r1 >= 0, lane, acc);          \
+        warp_tiles<CB, K2_, NT>(T, NTILES, kt0, per_warp, nt0, x0, x1, r0 >= 0, r1 >= 0, lane, ring, acc);          \
         break;
         TF_EXL3X_CASE(2)
         TF_EXL3X_CASE(3)
@@ -117,6 +173,8 @@ __device__ __forceinline__ void grouped_body(const GroupedArgs a, int u, int nbl
             __trap();
     }
 
+    cp_wait<0>();      // the ring's last (empty) groups
+    __syncwarp();      // ... and every lane is done with it: red takes its place
 #pragma unroll
     for (int i = 0; i < NT; ++i)
 #pragma unroll
