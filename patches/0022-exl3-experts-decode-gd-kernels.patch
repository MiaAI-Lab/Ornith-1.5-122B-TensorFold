+// Program (expert u, n block of NT tiles, split, member tile): 16 members times W_q over the split's K range, summed in warp
+// order; the same sums as grouped_body's, for any NT (a column's sum does not depend on how many its block has).
+template <int CB, int NT, int W>
+__device__ __forceinline__ void gd_body(const GroupedArgs a, int u, int nblock, int zz) {
+    if (u >= a.ucount[0]) return;
+    const int MT = (a.maxm + 15) / 16;
+    const int mtile = zz % MT;
+    const int split = (zz / MT) % a.sk;
+    const int mat = zz / MT / a.sk;
+    const half* X = mat ? a.x1 : a.x0;
+    const int e = a.standard ? a.uids[3 * u] : a.uids[u];
+    if (a.standard && e == a.skip) return;
+    const uint32_t* T = reinterpret_cast<const uint32_t*>(mat ? a.tp1[e] : a.tp0[e]);
+    const int k2 = mat ? a.k2_1[e] : a.k2_0[e];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int g = lane >> 2, t = lane & 3;
+    const int NTILES = a.ns > 0 ? a.ns : (a.n >> 4); // row stride of the trellis, in tiles
+    const int per_warp = (a.k >> 4) / a.sk / W;
+    const int kt0 = split * (per_warp * W) + warp * per_warp;
+    const int nt0 = nblock * NT;
+    if (a.standard && mtile * 16 >= a.uids[3 * u + 2]) return;   // an empty member tile
+
+    __shared__ int rows_sh[16];
+    __shared__ __align__(16) float red[W][16][NT * 16];   // the sums after the loop; the warp's span buffers before
+    uint32_t* ring = reinterpret_cast<uint32_t*>(&red[warp][0][0]);
+    static_assert(2 * NT * 64 * 4 <= 16 * NT * 16 * 4, "two spans of the widest width fit a warp's red slice");
+
     float acc[NT][2][4];
 #pragma unroll
     for (int i = 0; i < NT; ++i)
@@ -148,10 +283,11 @@ __device__ __forceinline__ void grouped_body(const GroupedArgs a, int u, int nbl
 #pragma unroll
             for (int c = 0; c < 4; ++c) acc[i][h][c] = 0.f;
 
+    bool live;
     switch (k2) {
 #define TF_EXL3X_CASE(K2_)                                                                                   \
     case K2_:                                                                                                \
-        warp_tiles<CB, K2_, NT>(T, NTILES, kt0, per_warp, nt0, x0, x1, r0 >= 0, r1 >= 0, lane, ring, acc);          \
+        live = gd_tiles<CB, K2_, NT, W>(a, T, NTILES, kt0, per_warp, nt0, mtile, u, X, rows_sh, ring, acc); \
