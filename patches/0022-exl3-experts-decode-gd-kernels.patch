+// Decode's grouped kernels run NT = GD_NT tiles (32 columns) a block: 4x the blocks of grouped_body's 8, so no half-empty wave.
+constexpr int GD_NT = 2;
+
+// A warp's k step of an expert matrix is NT tiles side by side, 16 * K2 contiguous bytes each: its lanes load that span as
+// coalesced 16-byte chunks (the shape that keeps GB10's memory busiest), two steps ahead in registers, and hand it through
+// a double buffer in the warp's own slice of shared memory to the decode, which reads each lane's overlapping words back.
+__device__ __forceinline__ uint4 gd_ldg16(const void* p) {
+    uint4 v;
+    asm volatile("ld.global.nc.L1::no_allocate.v4.u32 {%0,%1,%2,%3}, [%4];" : "=r"(v.x), "=r"(v.y), "=r"(v.z), "=r"(v.w) : "l"(p));
+    return v;
+}
+
+template <int K2, int NT>
+struct GdSpan {
+    static constexpr int TW = tile_words<K2>(), WORDS = NT * TW, CH = WORDS / 4, NJ = (CH + 31) / 32;
+};
+
+// Step `step` (k tile kt0 + step) of the warp's NT tiles into registers (nothing past the warp's last step).
+template <int K2, int NT>
+__device__ __forceinline__ void gd_span_load(uint4 (&R)[GdSpan<K2, NT>::NJ], const uint32_t* T, size_t kstride, int kt0, int nkt,
+                                          int nt0, int step, int lane) {
+    using S = GdSpan<K2, NT>;
+    if (step < nkt) {
+        const uint32_t* src = T + (size_t)(kt0 + step) * kstride + (size_t)nt0 * S::TW;
+#pragma unroll
+        for (int j = 0; j < S::NJ; ++j)
+            if (lane + 32 * j < S::CH) R[j] = gd_ldg16(src + 4 * (lane + 32 * j));
+    }
+}
+
+template <int K2, int NT>
+__device__ __forceinline__ void gd_span_store(const uint4 (&R)[GdSpan<K2, NT>::NJ], uint32_t* buf, int lane) {
+    using S = GdSpan<K2, NT>;
+#pragma unroll
+    for (int j = 0; j < S::NJ; ++j)
+        if (lane + 32 * j < S::CH) *reinterpret_cast<uint4*>(buf + 4 * (lane + 32 * j)) = R[j];
+}
+
+// Program (expert u, n block, split, member tile) for one width: the trellis spans are on their way before the member rows
+// reach shared memory; then 16 members times W_q over the warp's k tiles into acc. False: the member tile is empty.
+template <int CB, int K2, int NT, int W>
+__device__ __forceinline__ bool gd_tiles(const GroupedArgs& a, const uint32_t* T, int ntiles, int kt0, int nkt, int nt0, int mtile,
+                                           int u, const half* X, int* rows_sh, uint32_t* ring, float (&acc)[NT][2][4]) {
+    using S = GdSpan<K2, NT>;
+    constexpr int TW = S::TW, LW = lane_words<K2>();
+    const int lane = threadIdx.x & 31, g = lane >> 2, t = lane & 3;
+    const size_t kstride = (size_t)ntiles * TW;
+    uint4 A[S::NJ], B[S::NJ];
+    gd_span_load<K2, NT>(A, T, kstride, kt0, nkt, nt0, 0, lane);
+    gd_span_load<K2, NT>(B, T, kstride, kt0, nkt, nt0, 1, lane);
     if (threadIdx.x < 16) {
         const int m = mtile * 16 + threadIdx.x;
         const int count = a.standard ? a.uids[3 * u + 2] : a.maxm;
@@ -133,13 +197,84 @@ __device__ __forceinline__ void grouped_body(const GroupedArgs a, int u, int nbl
         rows_sh[threadIdx.x] = a.standard ? code : (code >= 0 ? (code >> 5) * a.slots + (code & 31) : -1);
     }
     __syncthreads();
-    if (rows_sh[0] < 0) {       // members come first, so this tile is empty
-        cp_wait<0>();
-        return;
-    }
+    if (rows_sh[0] < 0) return false;   // members come first, so this tile is empty
     const int r0 = rows_sh[g], r1 = rows_sh[g + 8];
     const half* x0 = X + (size_t)(r0 < 0 ? 0 : r0) * a.k + 2 * t;
     const half* x1 = X + (size_t)(r1 < 0 ? 0 : r1) * a.k + 2 * t;
+    const bool ok0 = r0 >= 0, ok1 = r1 >= 0;
+    int word, offset;
+    lane_start<K2>(lane, word, offset);
+    int woff[LW];
+#pragma unroll
+    for (int q = 0; q < LW; ++q) woff[q] = (word + q) % TW;
+
+    // step i is in buffer i & 1; A holds step i + 2 and B step i + 1 at the top of an even step
+    auto compute = [&](int i, const uint32_t* st) {
+        const int k = (kt0 + i) * 16;
+        const uint32_t av[4] = {ok0 ? *reinterpret_cast<const uint32_t*>(x0 + k) : 0u,
+                                ok1 ? *reinterpret_cast<const uint32_t*>(x1 + k) : 0u,
+                                ok0 ? *reinterpret_cast<const uint32_t*>(x0 + k + 8) : 0u,
+                                ok1 ? *reinterpret_cast<const uint32_t*>(x1 + k + 8) : 0u};
+        uint32_t w[NT][LW];
+#pragma unroll
+        for (int j = 0; j < NT; ++j)
+#pragma unroll
+            for (int q = 0; q < LW; ++q) w[j][q] = st[j * TW + woff[q]];
+#pragma unroll
+        for (int j = 0; j < NT; ++j) {
+            uint32_t b0[2], b1[2];
+            decode_lane<K2, CB>(w[j], lane, b0, b1);
+            mma16816(acc[j][0], av, b0);
+            mma16816(acc[j][1], av, b1);
+        }
+    };
+    uint32_t* buf0 = ring;
+    uint32_t* buf1 = ring + S::WORDS;
+    if (nkt > 0) gd_span_store<K2, NT>(A, buf0, lane);
+    gd_span_load<K2, NT>(A, T, kstride, kt0, nkt, nt0, 2, lane);
+    __syncwarp();
+    for (int i = 0; i < nkt; i += 2) {
+        compute(i, buf0);
+        if (i + 1 < nkt) gd_span_store<K2, NT>(B, buf1, lane);
+        gd_span_load<K2, NT>(B, T, kstride, kt0, nkt, nt0, i + 3, lane);
+        __syncwarp();
+        if (i + 1 < nkt) {
+            compute(i + 1, buf1);
+            if (i + 2 < nkt) gd_span_store<K2, NT>(A, buf0, lane);
+            gd_span_load<K2, NT>(A, T, kstride, kt0, nkt, nt0, i + 4, lane);
+            __syncwarp();
+        }
+    }
+    return true;
+}
