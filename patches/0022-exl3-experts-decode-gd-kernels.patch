-    cp_wait<0>();      // the ring's last (empty) groups
-    __syncwarp();      // ... and every lane is done with it: red takes its place
 #pragma unroll
     for (int i = 0; i < NT; ++i)
 #pragma unroll
@@ -213,6 +349,19 @@ extern "C" __global__ void tf_exl3_grouped_2(tf_exl3::GroupedArgs a) {  // mul1,
     tf_exl3::grouped_body<2, 8, 4>(a, blockIdx.x, blockIdx.y, blockIdx.z);
