+++ b/zig/src/families/qwen3_5/cuda_engine.zig
@@ -249,7 +249,7 @@ pub const Engine = struct {
         e.moe.fast_rows = std.c.getenv("TF_QWEN_ROUTER_TILE") == null;
         inline for (@typeInfo(Fns).@"struct".field_names) |name| @field(e.fns, name) = try e.mods[4].function("tf_q35_" ++ name);
         inline for (@typeInfo(Keeps).@"struct".field_names) |name| @field(e.keeps, name) = try e.mods[6].function("tf_q35k_" ++ name);
-        e.fp8 = .{ .rope = try e.mods[9].function("tf_q35_rope8"), .attn_partial = try e.mods[9].function("tf_q35_attn_partial8"), .attn_prompt = try e.mods[9].function("tf_q35_attn_prompt8"), .compact = try e.mods[9].function("tf_q35k_compact8") };
+        e.fp8 = .{ .rope = try e.mods[9].function("tf_q35_rope8"), .attn_partial = try e.mods[9].function("tf_q35_attn_partial8"), .attn_partial_b = try e.mods[9].function("tf_q35_attn_partial8_b"), .attn_prompt = try e.mods[9].function("tf_q35_attn_prompt8"), .compact = try e.mods[9].function("tf_q35k_compact8") };
         try e.fp8.attn_prompt.allowDynamicShared(prompt_smem8);
         e.old_attn = std.c.getenv("TF_QWEN_OLD_ATTN") != null;
         e.old_gdn = std.c.getenv("TF_QWEN_OLD_GDN") != null;
diff --git a/zig/src/families/qwen3_5/cuda_forward.zig b/zig/src/families/qwen3_5/cuda_forward.zig
index 534f039..a599b48 100644
--- a/zig/src/families/qwen3_5/cuda_forward.zig
+++ b/zig/src/families/qwen3_5/cuda_forward.zig
@@ -100,7 +100,8 @@ pub fn body(e: *E.Engine, shape: anytype) !void {
                     if (e.kv8) try e.runShared(e.fp8.attn_prompt, grid, .{ attn_prompt_rows * 32, 1, 1 }, E.prompt_smem8, args) else try e.run(e.fns.attn_prompt, grid, .{ attn_prompt_rows * 32, 1, 1 }, args);
                 } else {
                     if (total > E.attn_rows) return error.TooManyRows; // the partials hold attn_rows rows
-                    try e.run(if (e.kv8) e.fp8.attn_partial else e.fns.attn_partial, .{ max_chunks, g.kv_heads, total }, .{ 32 * group, 1, 1 }, .{ geo, e.qn, t_segs, t_rows, t_anc, ai, t_params, @as(f32, 1.0 / 16.0), e.pm, e.pl, e.po });
+                    const batched = group == 16 and head_dim == 256;
+                    try e.run(if (e.kv8) (if (batched) e.fp8.attn_partial_b else e.fp8.attn_partial) else (if (batched) e.fns.attn_partial_b else e.fns.attn_partial), .{ max_chunks, g.kv_heads, total }, .{ 32 * group, 1, 1 }, .{ geo, e.qn, t_segs, t_rows, t_anc, ai, t_params, @as(f32, 1.0 / 16.0), e.pm, e.pl, e.po });
                     try e.run(e.fns.attn_merge, .{ g.q_heads, total, 1 }, .{ 32, 1, 1 }, .{ geo, e.pm, e.pl, e.po, t_segs, t_rows, t_anc, t_params, e.y });
                 }
                 try e.run(e.fns.attn_gate, .{ (total * aw + 255) / 256, 1, 1 }, .{ 256, 1, 1 }, .{ geo, e.y, e.qraw, e.mix, @as(c_int, @intCast(total)), t_params });
diff --git a/zig/src/families/qwen3_5/cuda_layers.zig b/zig/src/families/qwen3_5/cuda_layers.zig
index 4c08bea..1618cc8 100644
--- a/zig/src/families/qwen3_5/cuda_layers.zig
+++ b/zig/src/families/qwen3_5/cuda_layers.zig
@@ -62,6 +62,7 @@ pub const Fns = struct {
     head_norm: cuda.Function,
