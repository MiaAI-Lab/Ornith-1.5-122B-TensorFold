     attn_merge: cuda.Function,
     attn_gate: cuda.Function,
@@ -77,4 +78,4 @@ pub const Fns = struct {
 pub const Keeps = struct { apply: cuda.Function, conv: cuda.Function, compact: cuda.Function };
 
 /// qwen35_kv8.cu's kernels: the cache writes, attention reads and keep's moves over e4m3 rows (--kv-cache fp8).
-pub const Kv8 = struct { rope: cuda.Function, attn_partial: cuda.Function, attn_prompt: cuda.Function, compact: cuda.Function };
+pub const Kv8 = struct { rope: cuda.Function, attn_partial: cuda.Function, attn_partial_b: cuda.Function, attn_prompt: cuda.Function, compact: cuda.Function };
