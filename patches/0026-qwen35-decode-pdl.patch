diff --git a/zig/kernels/cuda/pdl.cuh b/zig/kernels/cuda/pdl.cuh
new file mode 100644
index 0000000..cab2cf1
--- /dev/null
+++ b/zig/kernels/cuda/pdl.cuh
@@ -0,0 +1,19 @@
+// Programmatic dependent launch (sm_90+): a kernel launched with the PDL attribute may start (its blocks resident, running the
+// code before tf_pdl_wait) while the kernel before it finishes; tf_pdl_wait returns once that kernel is complete and its writes
+// visible. Launched without the attribute both are no-ops, so converted kernels run unchanged from any launch.
+#pragma once
+__device__ __forceinline__ void tf_pdl_wait() {
+#if __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.wait;\n" ::: "memory");
+#endif
+}
+__device__ __forceinline__ void tf_pdl_trigger() {
+#if __CUDA_ARCH__ >= 900
+    asm volatile("griddepcontrol.launch_dependents;\n" ::: "memory");
+#endif
+}
+// The usual start of a converted kernel: let the next kernel's blocks come up, wait for the previous one's results.
+__device__ __forceinline__ void tf_pdl_begin() {
+    tf_pdl_trigger();
+    tf_pdl_wait();
+}
